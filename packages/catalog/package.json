{
	"name": "@wwsff/catalog",
	"version": "0.1.0",
	"private": true,
	"description": "What can run: entries that declare their place in one browsable tree, wherever they live; tags with facets; URLs with run-time mixins and inputs.",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./node": "./dist/node.js"
	},
	"bin": {
		"catalog": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "tsc -p tsconfig.json && node --test dist/*.test.js",
		"cli": "tsc -p tsconfig.json && node dist/cli.js"
	},
	"dependencies": {
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/node": "^20.17.0",
		"typescript": "^5.8.0"
	}
}
