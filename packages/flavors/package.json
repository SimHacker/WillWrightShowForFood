{
	"name": "@wwsff/flavors",
	"version": "0.1.0",
	"private": true,
	"description": "Directories that inherit from directories: ordered multiple inheritance, merge-patch overlay rules, comments kept, any syntax in and out.",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./node": "./dist/node.js"
	},
	"bin": {
		"flavors": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "tsc -p tsconfig.json && node --test dist/*.test.js",
		"cli": "tsc -p tsconfig.json && node dist/cli.js"
	},
	"dependencies": {
		"fflate": "^0.8.3",
		"liquidjs": "^10.30.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/node": "^20.17.0",
		"typescript": "^5.8.0"
	}
}
