{
	"name": "@wwsff/sunos-bar",
	"version": "0.1.0",
	"private": true,
	"description": "Read SunOS 4 bar archives (raw 1/4-inch Sun tape dumps), with compress(1) .Z decoding, in TypeScript.",
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"bin": {
		"sunos-bar": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "tsc -p tsconfig.json && node --test dist/*.test.js",
		"cli": "tsc -p tsconfig.json && node dist/cli.js"
	},
	"devDependencies": {
		"@types/node": "^20.17.0",
		"typescript": "^5.8.0"
	}
}
