+// bootWriteProtect is the write-protect tab the user set for a drive (-drive1wp, -drive2wp, or
+// insertDisk's fourth argument in the browser); every insert into that drive honors it.
+func bootWriteProtect(index, drive int) bool {
+	if drive%2 == 1 {
+		return settings.PureBootVolumeWP2[index]
+	}
+	return settings.PureBootVolumeWP[index]
+}
