+// protect write-protects the inserted disk when wp is set. It never clears protection a WOZ
+// image declares itself.
+func (d *DiskIIDrive) protect(wp bool) {
+	if !wp {
+		return
+	}
+	if d.Disk != nil {
+		d.Disk.SetWriteProtected(true)
+	}
+	if d.NibImage != nil {
+		d.NibImage.WriteProtected = true
+	}
+}
