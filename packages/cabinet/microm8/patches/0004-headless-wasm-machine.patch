--- /dev/null
+++ b/GoPath/src/paleotronic.com/core/hardware/common/serialcommand_js.go
@@ -0,0 +1,25 @@
+//go:build js && wasm
+
+package common
+
+import (
+	"os/exec"
+	"strings"
+)
+
+// A browser can't run a host command behind the serial card; Start fails and the card stays idle.
+
+func (e *Executor) Stop() {
+	e.r = false
+}
+
+func NewExecutor(commandString string) *Executor {
+	return &Executor{
+		cmd:         exec.Command("sh", "-c", commandString),
+		toCommand:   make(chan byte, 1024),
+		fromCommand: make(chan byte, 24576),
+		echo:        !strings.Contains(commandString, "telnet"),
+		crToLF:      !strings.Contains(commandString, "telnet"),
+		addCRtoLF:   true,
+	}
+}
