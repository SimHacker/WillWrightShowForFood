--- /dev/null
+++ b/GoPath/src/paleotronic.com/third_party/atotto-clipboard/clipboard_js.go
@@ -0,0 +1,26 @@
+//go:build js && wasm
+
+package clipboard
+
+import "sync"
+
+// The browser's clipboard is asynchronous and needs a user gesture, so the WebAssembly build
+// keeps its own; the page copies between it and navigator.clipboard.
+
+var (
+	mu   sync.Mutex
+	text string
+)
+
+func readAll() (string, error) {
+	mu.Lock()
+	defer mu.Unlock()
+	return text, nil
+}
+
+func writeAll(t string) error {
+	mu.Lock()
+	defer mu.Unlock()
+	text = t
+	return nil
+}
diff --git a/GoPath/src/paleotronic.com/third_party/atotto-clipboard/clipboard_plan9.go b/GoPath/src/paleotronic.com/third_party/atotto-clipboard/clipboard_plan9.go
