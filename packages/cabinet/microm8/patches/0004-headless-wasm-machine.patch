@@ -0,0 +1,57 @@
+//go:build js && wasm
+
+package plus
+
+import (
+	"errors"
+
+	"paleotronic.com/core/dialect"
+	"paleotronic.com/core/types"
+)
+
+// @builtin.chat{} and @builtin.forum{} talk to paleotronic.com's servers, whose client
+// packages aren't published; in the browser they report that instead of linking them.
+
+type PlusBuiltinChat struct {
+	dialect.CoreFunction
+}
+
+func (this *PlusBuiltinChat) FunctionExecute(params *types.TokenList) error {
+	return errors.New("chat is not available in the browser build")
+}
+
+func (this *PlusBuiltinChat) Syntax() string { return "REBOOT{}" }
+
+func (this *PlusBuiltinChat) FunctionParams() []types.TokenType {
+	return []types.TokenType{types.STRING}
+}
+
+func NewPlusBuiltinChat(a int, b int, params types.TokenList) *PlusBuiltinChat {
+	this := &PlusBuiltinChat{}
+	this.CoreFunction = *dialect.NewCoreFunction(a, b, params)
+	this.Name = "REBOOT"
+	this.MinParams = 0
+	this.MaxParams = 1
+	return this
+}
+
+type PlusBuiltinForum struct {
+	dialect.CoreFunction
+}
+
+func (this *PlusBuiltinForum) FunctionExecute(params *types.TokenList) error {
+	return errors.New("the forum is not available in the browser build")
+}
+
+func (this *PlusBuiltinForum) Syntax() string { return "REBOOT{}" }
+
+func (this *PlusBuiltinForum) FunctionParams() []types.TokenType {
+	return []types.TokenType{}
+}
+
+func NewPlusBuiltinForum(a int, b int, params types.TokenList) *PlusBuiltinForum {
+	this := &PlusBuiltinForum{}
+	this.CoreFunction = *dialect.NewCoreFunction(a, b, params)
+	this.Name = "REBOOT"
+	return this
+}
