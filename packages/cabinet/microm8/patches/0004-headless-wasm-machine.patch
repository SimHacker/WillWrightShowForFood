+// Disk images held in memory under a "local:" path, for hosts without a file system (wasm).
+// ReadLocal and WriteLocal use the map for any path stored here, and the OS otherwise, so a
+// guest that saves to an in-memory disk updates the map and the host can read it back.
+var memVolumes sync.Map
+
+func ReadLocal(path string) ([]byte, error) {
+	if data, ok := MemVolume(path); ok {
+		return data, nil
+	}
+	return os.ReadFile(strings.TrimPrefix(path, "local:"))
+}
+
+func WriteLocal(path string, data []byte) error {
+	if _, ok := memVolumes.Load(path); ok {
+		memVolumes.Store(path, append([]byte(nil), data...))
+		return nil
+	}
+	return os.WriteFile(strings.TrimPrefix(path, "local:"), data, 0644)
+}
+
+func SetMemVolume(path string, data []byte) {
+	if data == nil {
+		memVolumes.Delete(path)
+		return
+	}
+	memVolumes.Store(path, data)
+}
+
+func MemVolume(path string) ([]byte, bool) {
+	v, ok := memVolumes.Load(path)
+	if !ok {
+		return nil, false
+	}
+	return v.([]byte), true
+}
