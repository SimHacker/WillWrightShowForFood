+//go:build js && wasm
+
+// microM8 as a WebAssembly module: the Apple runs headless in Go, and JavaScript drives it
+// through globalThis.microM8. No GL, no window, no network. The screen is the scan
+// renderer's 560x192 RGBA frame, which the core makes at every vertical blank.
+package main
+
+import (
+	"encoding/binary"
+	"io"
+	stdlog "log"
+	"math"
+	"sync"
+	"syscall/js"
+	"time"
+
+	"paleotronic.com/core/hardware/apple2"
+	"paleotronic.com/core/hardware/apple2helpers"
+	"paleotronic.com/core/hardware/servicebus"
+	"paleotronic.com/core/interfaces"
+	"paleotronic.com/core/memory"
+	"paleotronic.com/core/settings"
+	"paleotronic.com/files"
+	"paleotronic.com/octalyzer/backend"
+	"paleotronic.com/runestring"
+)
+
+var ram *memory.MemoryMap
+
+const slot = 0
+
+func ready() bool {
+	return backend.ProducerMain != nil && backend.ProducerMain.GetInterpreter(slot) != nil
+}
+
+// innermost is the interpreter actually running: microM8 nests one per launched program.
+func innermost() interfaces.Interpretable {
+	e := backend.ProducerMain.GetInterpreter(slot)
+	for e.GetChild() != nil {
+		e = e.GetChild()
+	}
+	return e
+}
+
+// The speaker's samples (float32, settings.SampleRate a second), kept until JavaScript takes
+// them with audio(). A page that stops taking them loses the oldest, never the machine's time.
+var sound struct {
+	sync.Mutex
+	buf  []float32
+	rate int
+}
+
+const soundKeep = 48000 / 2
+
+func speakerOut(index int, channel int, data []uint64, rate int, packed bool) {
+	if channel != 0 || packed {
+		return
+	}
+	sound.Lock()
+	defer sound.Unlock()
+	sound.rate = rate
+	for _, v := range data {
+		sound.buf = append(sound.buf, math.Float32frombits(uint32(v)))
+	}
+	if over := len(sound.buf) - soundKeep; over > 0 {
+		sound.buf = append(sound.buf[:0], sound.buf[over:]...)
+	}
+}
+
+func boot() {
+	settings.Verbose = js.Global().Get("microM8Verbose").Truthy()
+	if !settings.Verbose {
+		stdlog.SetOutput(io.Discard)
+	}
+	settings.EBOOT = true
+	settings.DONTLOG = true
+	files.System = false
+	// No serial line, printer or Mockingboard output in the browser yet.
+	for _, card := range []string{"superserialcard", "parallel", "mockingboard", "uthernet"} {
+		settings.OmitCards[card] = true
+	}
+	// Start as a bare Apple at the ROM reset routine, not the microM8 menu.
+	settings.PureBootVolume[slot] = "ram:0xfa62"
+	ram = memory.NewMemoryMap()
+	for i := 0; i < memory.OCTALYZER_NUM_INTERPRETERS; i++ {
+		ram.SlotReset(i)
+	}
+	ram.SetWaveCallback(slot, speakerOut)
+	go backend.Run(ram, nil)
+	ram.InputToggle(slot)
+}
+
+func ioChip() *apple2.Apple2IOChip {
+	mr, ok := ram.InterpreterMappableAtAddress(slot, 0xc000)
+	if !ok {
+		return nil
+	}
+	io, _ := mr.(*apple2.Apple2IOChip)
+	return io
+}
+
+// The game port's pushbuttons as microM8 stores them: $C063 (PB2) reads its button 3.
+var buttonIndex = [3]int{0, 1, 3}
+
+func bytesArg(v js.Value) []byte {
+	b := make([]byte, v.Get("length").Int())
+	js.CopyBytesToGo(b, v)
+	return b
+}
+
+func api() map[string]any {
+	return map[string]any{
+		"ready": js.FuncOf(func(this js.Value, args []js.Value) any {
+			return ready()
+		}),
+		// insertDisk(drive, name, bytes): drive 0 or 1 is a Disk II drive; 3.5" and hard disk
+		// images go to the SmartPort whatever the drive. The image also becomes the boot
+		// volume for that drive, so reboot() boots it.
+		"insertDisk": js.FuncOf(func(this js.Value, args []js.Value) any {
+			drive, name, data := args[0].Int(), args[1].String(), bytesArg(args[2])
+			path := "local:/mem/" + name
+			settings.SetMemVolume(path, data)
+			kind := servicebus.DiskIIInsertBytes
+			if files.Apple2IsHighCapacity(files.GetExt(name), len(data)) {
+				kind = servicebus.SmartPortInsertBytes
+				settings.PureBootSmartVolume[slot] = path
+			} else if drive == 1 {
+				settings.PureBootVolume2[slot] = path
+			} else {
+				settings.PureBootVolume[slot] = path
+			}
+			servicebus.SendServiceBusMessage(slot, kind, servicebus.DiskTargetBytes{Filename: path, Drive: drive, Bytes: data})
+			return kind == servicebus.SmartPortInsertBytes
+		}),
+		// flush() writes changed tracks back into the in-memory images; volume(name) then
+		// returns the image as the guest left it, or null.
+		"flush": js.FuncOf(func(this js.Value, args []js.Value) any {
+			servicebus.SendServiceBusMessage(slot, servicebus.DiskIIFlush, 0)
+			servicebus.SendServiceBusMessage(slot, servicebus.DiskIIFlush, 1)
+			servicebus.SendServiceBusMessage(slot, servicebus.SmartPortFlush, 0)
+			return nil
+		}),
+		"volume": js.FuncOf(func(this js.Value, args []js.Value) any {
+			data, ok := settings.MemVolume("local:/mem/" + args[0].String())
+			if !ok {
+				return nil
+			}
+			out := js.Global().Get("Uint8Array").New(len(data))
+			js.CopyBytesToJS(out, data)
+			return out
+		}),
+		"reboot": js.FuncOf(func(this js.Value, args []js.Value) any {
+			backend.ProducerMain.RestartSlot(slot)
+			return nil
+		}),
+		// audio(into) moves waiting speaker samples into `into`, a Uint8Array over a
+		// Float32Array's buffer, and returns how many floats it wrote. audioRate() is their rate.
+		"audio": js.FuncOf(func(this js.Value, args []js.Value) any {
+			sound.Lock()
+			defer sound.Unlock()
+			n := len(sound.buf)
+			if most := args[0].Get("length").Int() / 4; n > most {
+				n = most
+			}
+			if n == 0 {
+				return 0
+			}
+			b := make([]byte, n*4)
+			for i, v := range sound.buf[:n] {
+				binary.LittleEndian.PutUint32(b[i*4:], math.Float32bits(v))
+			}
+			js.CopyBytesToJS(args[0], b)
+			sound.buf = append(sound.buf[:0], sound.buf[n:]...)
+			return n
+		}),
+		"audioRate": js.FuncOf(func(this js.Value, args []js.Value) any {
+			if sound.rate == 0 {
+				return settings.SampleRate
+			}
+			return sound.rate
+		}),
+		// reset() is Ctrl-Reset: the 6502 takes its reset vector, memory stays.
+		"reset": js.FuncOf(func(this js.Value, args []js.Value) any {
+			// microM8 mutes the speaker while a drive spins; a reset that stops a boot leaves it so.
+			settings.MuteCPU = false
+			apple2helpers.GetCPU(innermost()).PullResetLine()
+			return nil
+		}),
+		// speed(n) runs the 6502 at n times an Apple's 1.02 MHz; a reboot keeps it.
+		"speed": js.FuncOf(func(this js.Value, args []js.Value) any {
+			settings.BootWarp = args[0].Float()
+			apple2helpers.GetCPU(innermost()).SetWarpUser(args[0].Float())
+			return nil
+		}),
+		"status": js.FuncOf(func(this js.Value, args []js.Value) any {
+			cpu := apple2helpers.GetCPU(innermost())
+			e := innermost()
+			modes := []any{}
+			for _, m := range apple2helpers.GetActiveVideoModes(e) {
+				modes = append(modes, m)
+			}
+			for _, m := range apple2helpers.GetActiveTextModes(e) {
+				modes = append(modes, m)
+			}
+			return map[string]any{
+				"dialect":  e.GetDialect().GetShortName(),
+				"pureBoot": settings.PureBoot(slot),
+				"pc":       cpu.PC, "a": cpu.A, "x": cpu.X, "y": cpu.Y, "sp": cpu.SP, "p": cpu.P,
+				"modes":  modes,
+				"speed":  cpu.GetWarp(),
+				"cycles": float64(cpu.GlobalCycles),
+				"disk0":  settings.PureBootVolume[slot],
+			}
+		}),
+		// paddle(n, value): game port paddle n (0-3) turned to value, 0 to 255.
+		"paddle": js.FuncOf(func(this js.Value, args []js.Value) any {
+			n, v := args[0].Int(), args[1].Int()
+			if n >= 0 && n < 4 {
+				ram.IntSetPaddleValue(slot, n, uint64(min(max(v, 0), 255)))
+			}
+			return nil
+		}),
+		// button(n, down): pushbutton n (0-2); on a //e, 0 and 1 are also Open and Solid Apple.
+		"button": js.FuncOf(func(this js.Value, args []js.Value) any {
+			n, state := args[0].Int(), uint64(0)
+			if args[1].Truthy() {
+				state = 1
+			}
+			if n >= 0 && n < 3 {
+				ram.IntSetPaddleButton(slot, buttonIndex[n], state)
+			}
+			return nil
+		}),
+		// annunciators() is the game port's four outputs AN0-AN3 as bits 0-3.
+		"annunciators": js.FuncOf(func(this js.Value, args []js.Value) any {
+			if io := ioChip(); io != nil {
+				return io.Annunciators()
+			}
+			return 0
+		}),
+		"key": js.FuncOf(func(this js.Value, args []js.Value) any {
+			ram.KeyBufferAdd(slot, uint64(args[0].Int()))
+			return nil
+		}),
+		"type": js.FuncOf(func(this js.Value, args []js.Value) any {
+			e := backend.ProducerMain.GetInterpreter(slot)
+			e.SetPasteBuffer(runestring.Cast(e.GetPasteBuffer().String() + args[0].String()))
+			return nil
+		}),
+		"readMemory": js.FuncOf(func(this js.Value, args []js.Value) any {
+			addr, n := args[0].Int(), args[1].Int()
+			e := backend.ProducerMain.GetInterpreter(slot)
+			b := make([]byte, n)
+			for i := range b {
+				b[i] = byte(e.GetMemory(addr + i))
+			}
+			out := js.Global().Get("Uint8Array").New(n)
+			js.CopyBytesToJS(out, b)
+			return out
+		}),
+		"writeMemory": js.FuncOf(func(this js.Value, args []js.Value) any {
+			addr, b := args[0].Int(), bytesArg(args[1])
+			e := backend.ProducerMain.GetInterpreter(slot)
+			for i, x := range b {
+				e.SetMemory(addr+i, uint64(x))
+			}
+			return nil
+		}),
+		// frame(dst) copies the newest frame into dst (a Uint8Array or Uint8ClampedArray of
+		// 560*192*4 bytes) and returns true, or returns false when nothing changed.
+		"frame": js.FuncOf(func(this js.Value, args []js.Value) any {
+			f := settings.UnifiedRenderFrame[slot]
+			if f == nil || !settings.UnifiedRenderChanged[slot] {
+				return false
+			}
+			settings.UnifiedRenderChanged[slot] = false
+			js.CopyBytesToJS(args[0], f.Pix)
+			return true
+		}),
+		// stop() ends the Go program, so a Node process can exit.
+		"stop": js.FuncOf(func(this js.Value, args []js.Value) any {
+			close(stop)
+			return nil
+		}),
+		"width":  560,
+		"height": 192,
+	}
+}
+
+var stop = make(chan struct{})
+
+func main() {
+	m := js.Global().Get("Object").New()
+	for k, v := range api() {
+		m.Set(k, v)
+	}
+	js.Global().Set("microM8", m)
+	boot()
+	// Counted in turns, not seconds: a hidden tab runs timers late, and the boot with them.
+	for turn := 0; !ready() && turn < 3000; turn++ {
+		time.Sleep(10 * time.Millisecond)
+	}
+	if cb := js.Global().Get("onMicroM8Ready"); cb.Type() == js.TypeFunction {
+		cb.Invoke(ready())
+	}
+	<-stop
+}
