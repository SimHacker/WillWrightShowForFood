+//go:build js && wasm
+
+// The cgo stb_vorbis decoder can't build for js/wasm; Ogg audio is unavailable there.
+package vorbis
+
+import (
+	"errors"
+	"io"
+	"time"
+)
+
+var errUnavailable = errors.New("vorbis: not available in js/wasm")
+
+type Vorbis struct {
+	Channels   int
+	SampleRate int
+}
+
+func Decode(b []byte) (data []int16, channels int, sampleRate int, err error) {
+	return nil, 0, 0, errUnavailable
+}
+
+func Length(b []byte) (time.Duration, error) {
+	return 0, errUnavailable
+}
+
+func New(r io.Reader) (*Vorbis, error) {
+	return nil, errUnavailable
+}
+
+func (v *Vorbis) Decode() (data []float32, err error) {
+	return nil, errUnavailable
+}
+
+func (v *Vorbis) Close() {}
