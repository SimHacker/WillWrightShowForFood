diff --git a/GoPath/src/paleotronic.com/octalyzer/assets/extra.go b/GoPath/src/paleotronic.com/octalyzer/assets/extra.go
new file mode 100644
index 0000000..3a6c9f8
--- /dev/null
+++ b/GoPath/src/paleotronic.com/octalyzer/assets/extra.go
@@ -0,0 +1,49 @@
+package assets
+
+import (
+	"embed"
+	"io/fs"
+	"os"
+	"path"
+
+	"paleotronic.com/octalyzer/data"
+)
+
+//go:embed profile-extra/*.yaml
+var extraProfiles embed.FS
+
+// Profiles and ROMs added after assets.go was generated. Regenerating assets.go
+// would drop every profile: their sources are not in the tree, only the gzipped
+// copies inside that file.
+func init() {
+	addDir(data.Videx, ".", "data/", nil)
+	addDir(extraProfiles, "profile-extra", "profile/", _bintree.Children["profile"])
+}
+
+func addDir(fsys fs.FS, dir, prefix string, tree *bintree) {
+	entries, err := fs.ReadDir(fsys, dir)
+	if err != nil {
+		return
+	}
+	for _, e := range entries {
+		if e.IsDir() {
+			continue
+		}
+		b, err := fs.ReadFile(fsys, path.Join(dir, e.Name()))
+		if err != nil {
+			continue
+		}
+		name := prefix + e.Name()
+		bb := append([]byte(nil), b...)
+		fn := func() (*asset, error) {
+			return &asset{
+				bytes: bb,
+				info:  bindataFileInfo{name: name, size: int64(len(bb)), mode: os.FileMode(0444)},
+			}, nil
+		}
+		_bindata[name] = fn
+		if tree != nil {
+			tree.Children[e.Name()] = &bintree{Func: fn, Children: map[string]*bintree{}}
+		}
+	}
+}
