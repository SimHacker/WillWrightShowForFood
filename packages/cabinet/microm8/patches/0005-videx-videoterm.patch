index 0000000..379d885
--- /dev/null
+++ b/GoPath/src/paleotronic.com/core/hardware/apple2/videx.go
@@ -0,0 +1,287 @@
+package apple2
+
+import (
+	"paleotronic.com/core/hardware/common"
+	"paleotronic.com/core/interfaces"
+	"paleotronic.com/core/memory"
+	"paleotronic.com/fmt"
+	"paleotronic.com/log"
+
+	yaml "gopkg.in/yaml.v2"
+)
+
+// VidexWidth and VidexHeight are the card's picture: 80 cells of 9 dots by 24
+// cells of 9 lines. The Apple //e's 80-column text is drawn the same way, one
+// font dot to one pixel, white on black; this is that, from the Videoterm's
+// own character ROM.
+const (
+	VidexWidth  = 720
+	VidexHeight = 216
+)
+
+// Register write masks. R16 and R17 are not written by the 6502.
+var videxRegMask = [16]byte{
+	0xff, 0xff, 0xff, 0x0f,
+	0x7f, 0x1f, 0x7f, 0x7f,
+	0x03, 0x1f, 0x7f, 0x1f,
+	0x3f, 0xff, 0x3f, 0xff,
+}
+
+// IOCardVidex is a Videx Videoterm: a 6845 and 2K of screen RAM, firmware in
+// the slot ROM and at $C800, screen RAM paged into $CC00-$CDFF.
+type IOCardVidex struct {
+	IOCard
+	e         interfaces.Interpretable
+	ram       [0x800]byte
+	reg       [18]byte
+	sel       int
+	page      int
+	chr       [2][0x800]byte
+	changed   bool
+	lastBlink int
+}
+
+func NewIOCardVidex(mm *memory.MemoryMap, index int, ent interfaces.Interpretable) *IOCardVidex {
+	c := &IOCardVidex{e: ent, lastBlink: -1}
+	c.Name = "IOCardVidex"
+	c.mm = mm
+	c.index = index
+	c.loadCharset(0, "data/videx_chr.rom")
+	c.loadCharset(1, "data/videx_chr_inverse.rom")
+	return c
+}
+
+func (c *IOCardVidex) loadCharset(set int, name string) {
+	data, err := common.LoadData(name, 0, 0x800)
+	if err != nil {
+		log.Printf("videx: %s: %s", name, err.Error())
+		return
+	}
+	for i, v := range data {
+		if i < len(c.chr[set]) {
+			c.chr[set][i] = byte(v)
+		}
+	}
+}
+
+func (c *IOCardVidex) HandleIO(register int, value *uint64, t IOType) {
+	c.page = (register >> 2) & 3
+	if register&1 == 0 {
+		if t == IOT_WRITE {
+			c.sel = int(*value) & 0x1f
+		} else {
+			*value = 0
+		}
+		return
+	}
+	if t == IOT_WRITE {
+		c.writeReg(byte(*value))
+		return
+	}
+	*value = uint64(c.readReg())
+}
+
+func (c *IOCardVidex) writeReg(v byte) {
+	if c.sel > 15 {
+		return
+	}
+	c.reg[c.sel] = v & videxRegMask[c.sel]
+	c.changed = true
+}
+
+func (c *IOCardVidex) readReg() byte {
+	if c.sel >= 14 && c.sel <= 17 {
+		return c.reg[c.sel]
+	}
+	return 0
+}
+
+func (c *IOCardVidex) RedirectedRead(offset int) uint64 {
+	if offset >= 0x400 && offset < 0x600 {
+		return uint64(c.ram[(offset&0x1ff)+c.page*512])
+	}
+	return 0
+}
+
+func (c *IOCardVidex) RedirectedWrite(offset int, value uint64) {
+	if offset >= 0x400 && offset < 0x600 {
+		c.ram[(offset&0x1ff)+c.page*512] = byte(value)
+		c.changed = true
+	}
+}
+
+// C8RAM reports the screen window. The firmware above it stays ordinary ROM,
+// so the 6502 executes it; a firmware memory block would swallow the opcode.
+func (c *IOCardVidex) C8RAM(addr int) bool {
+	return addr >= 0xcc00 && addr < 0xce00
+}
+
+func (c *IOCardVidex) Reset() {
+	c.page = 0
+}
+
+func (c *IOCardVidex) ImA() string {
+	return "videx"
+}
+
+func (c *IOCardVidex) Init(slot int) {
+	c.IOCard.Init(slot)
+}
+
+// LoadROM maps the slot ROM and leaves it readable. IOCard.LoadROM parks slot
+// 3 in state "off", which is how a //e hides it behind the internal firmware.
+// A II+ has no internal firmware there.
+func (c *IOCardVidex) LoadROM(ent interfaces.Interpretable, addr int) {
+	c.IOCard.LoadROM(ent, addr)
+	slot := (addr - 0xc000) / 256
+	if mb := ent.GetMemoryMap().BlockMapper[ent.GetMemIndex()].Get(fmt.Sprintf("slot%d.rom", slot)); mb != nil {
+		mb.SetState("r")
+	}
+}
+
+type videxState struct {
+	RAM  []byte `yaml:"ram"`
+	Reg  []byte `yaml:"reg"`
+	Sel  int    `yaml:"sel"`
+	Page int    `yaml:"page"`
+}
+
+func (c *IOCardVidex) GetYAML() []byte {
+	b, _ := yaml.Marshal(videxState{
+		RAM: append([]byte(nil), c.ram[:]...),
+		Reg: append([]byte(nil), c.reg[:]...),
+		Sel: c.sel, Page: c.page,
+	})
+	return b
+}
+
+func (c *IOCardVidex) SetYAML(b []byte) {
+	var s videxState
+	if yaml.Unmarshal(b, &s) != nil {
+		return
+	}
+	copy(c.ram[:], s.RAM)
+	copy(c.reg[:], s.Reg)
+	c.sel = s.Sel
+	c.page = s.Page
+	c.changed = true
+}
+
+// Snapshot is the 2K of screen RAM, then R12 and R13, the start address.
+func (c *IOCardVidex) Snapshot() []byte {
+	b := make([]byte, 2050)
+	copy(b, c.ram[:])
+	b[2048] = c.reg[12]
+	b[2049] = c.reg[13]
+	return b
+}
+
+// Render draws the card into dst (VidexWidth by VidexHeight, RGBA) and reports
+// whether it differs from the last call. cycles is the 6502's cycle count; the
+// cursor blinks from it. Lit dots are the same white the //e 80-column renderer
+// writes (palette 15), unlit the same black, alpha 255.
+func (c *IOCardVidex) Render(dst []byte, cycles int64) bool {
+	if len(dst) < VidexWidth*VidexHeight*4 {
+		return false
+	}
+	field := 0
+	if cycles > 0 {
+		field = int(cycles / 17030)
+	}
+	mode := (c.reg[10] >> 5) & 3
+	blink := 0
+	switch mode {
+	case 0:
+		blink = 1
+	case 2:
+		if (field/8)&1 == 0 {
+			blink = 1
+		}
+	case 3:
+		if (field/16)&1 == 0 {
+			blink = 1
+		}
+	}
+	if !c.changed && blink == c.lastBlink {
+		return false
+	}
+	c.changed = false
+	c.lastBlink = blink
+
+	for i := 0; i < VidexWidth*VidexHeight*4; i += 4 {
+		dst[i], dst[i+1], dst[i+2], dst[i+3] = 0, 0, 0, 255
+	}
+
+	cols := int(c.reg[1])
+	if cols < 1 {
+		cols = 1
+	}
+	if cols > 80 {
+		cols = 80
+	}
+	rows := int(c.reg[6])
+	if rows < 1 {
+		rows = 1
+	}
+	if rows > 24 {
+		rows = 24
+	}
+	lines := int(c.reg[9]) + 1
+	if lines > 16 {
+		lines = 16
+	}
+	ma := int(c.reg[12])<<8 | int(c.reg[13])
+	cur := (int(c.reg[14])<<8 | int(c.reg[15])) & 0x7ff
+	c0 := int(c.reg[10] & 31)
+	c1 := int(c.reg[11] & 31)
+
+	for y := 0; y < rows; y++ {
+		for l := 0; l < lines; l++ {
+			py := y*lines + l
+			if py >= VidexHeight {
+				break
+			}
+			row := dst[py*VidexWidth*4:]
+			for x := 0; x < cols; x++ {
+				cell := (ma + y*cols + x) & 0x7ff
+				b := c.ram[cell]
+				bits := c.chr[b>>7][int(b&0x7f)*16+(l&15)]
+				invert := blink == 1 && cell == cur && l >= c0 && l <= c1
+				for dot := 0; dot < 9; dot++ {
+					px := x*9 + dot
+					if px >= VidexWidth {
+						break
+					}
+					on := bits&(0x80>>dot) != 0
+					if dot == 8 {
+						on = bits&1 != 0
+					}
+					if invert {
+						on = !on
+					}
+					if on {
+						o := px * 4
+						row[o], row[o+1], row[o+2], row[o+3] = 255, 255, 255, 255
+					}
+				}
+			}
+		}
+	}
+	return true
+}
+
+// Videx returns the Videoterm if one is plugged in.
+func (mr *Apple2IOChip) Videx() *IOCardVidex {
+	for _, card := range mr.cards {
+		if v, ok := card.(*IOCardVidex); ok {
+			return v
+		}
+	}
+	return nil
+}
+
+// VidexShowing is what the Soft Video Switch puts on the monitor: the card,
+// when annunciator 0 is on and the Apple is not in a graphics mode.
+func (mr *Apple2IOChip) VidexShowing() bool {
+	return mr.Videx() != nil && mr.annunciators[0] && mr.SW_TEXT()
+}
