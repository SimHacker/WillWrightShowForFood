+
+func TestVidexAssets(t *testing.T) {
+	fw, err := assets.Asset("data/videx_fw24.rom")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(fw) != 1024 {
+		t.Fatalf("firmware is %d bytes", len(fw))
+	}
+	spec, err := assets.Asset("profile/apple2-plus-videx.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(spec)
+	if !strings.Contains(text, `id  : "apple2-plus-videx"`) || !strings.Contains(text, `driver: "videx"`) {
+		t.Fatal("profile is not the II+ with a Videx in slot 3")
+	}
+}
+
+func TestVidexGlyph(t *testing.T) {
+	rom, err := assets.Asset("data/videx_chr.rom")
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := NewIOCardVidex(nil, 0, nil)
+	// Firmware 2.4's init table at ROM $A1, written the way the card's loop does.
+	init := []byte{0x7A, 0x50, 0x5E, 0x2F, 0x22, 0x00, 0x18, 0x1D, 0x00, 0x08, 0xE0, 0x08, 0x00, 0x00, 0x00, 0x00}
+	for i, v := range init {
+		sel, val := uint64(i), uint64(v)
+		c.HandleIO(0, &sel, IOT_WRITE)
+		c.HandleIO(1, &val, IOT_WRITE)
+	}
+	c.ram[0] = 0x41
+	dst := make([]byte, VidexWidth*VidexHeight*4)
+	if !c.Render(dst, 0) {
+		t.Fatal("first render did not draw")
+	}
+	// Glyph $41 is an A on lines 0-6. Dot 7 is the leftmost bit. A blink of
+	// period 32 (R10 = $E0) is on at field 0, and the cursor is on cell 0,
+	// so the cell is inverted: a lit ROM dot is black.
+	for line := 0; line < 7; line++ {
+		bits := rom[0x410+line]
+		row := dst[line*VidexWidth*4:]
+		for dot := 0; dot < 8; dot++ {
+			lit := bits&(0x80>>dot) != 0
+			pix := row[dot*4]
+			if lit && pix != 0 {
+				t.Fatalf("line %d dot %d: cursor should invert a lit dot, got %d", line, dot, pix)
+			}
+			if !lit && pix != 255 {
+				t.Fatalf("line %d dot %d: cursor should invert an unlit dot, got %d", line, dot, pix)
+			}
+		}
+		repeat := rom[0x410+line]&1 != 0
+		got := row[8*4]
+		if repeat && got != 0 || !repeat && got != 255 {
+			t.Fatalf("line %d dot 8: bit0 %v pixel %d", line, repeat, got)
+		}
+	}
+	// Hide the cursor (mode 1) and the same dots are the ROM, uninverted.
+	sel, val := uint64(10), uint64(0x20)
+	c.HandleIO(0, &sel, IOT_WRITE)
+	c.HandleIO(1, &val, IOT_WRITE)
+	if !c.Render(dst, 0) {
+		t.Fatal("cursor change did not redraw")
+	}
+	for line := 0; line < 7; line++ {
+		bits := rom[0x410+line]
+		row := dst[line*VidexWidth*4:]
+		for dot := 0; dot < 8; dot++ {
+			lit := bits&(0x80>>dot) != 0
+			pix := row[dot*4]
+			if lit && pix != 255 || !lit && pix != 0 {
+				t.Fatalf("line %d dot %d: rom bit %v pixel %d", line, dot, lit, pix)
+			}
+		}
+	}
+}
