+// AddressWrite_Cxxx serves the writable half of $C800. A write of $CFFF
+// releases the space. A write the owning card claims goes to its RAM and is
+// not stored in the 64K. Anything else is written as it was before.
+func (mr *Apple2IOChip) AddressWrite_Cxxx(addr int, value *uint64) (bool, bool) {
+	if addr == 0xCFFF {
+		mr.releaseC8()
+		return false, false
