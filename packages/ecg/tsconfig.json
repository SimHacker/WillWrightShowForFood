{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"sourceMap": true,
		"lib": ["ES2020"],
		"types": ["node"],
		"module": "Node16",
		"moduleResolution": "Node16",
		"noEmit": false,
		"noUncheckedIndexedAccess": false
	},
	"include": ["src/**/*.ts"]
}
