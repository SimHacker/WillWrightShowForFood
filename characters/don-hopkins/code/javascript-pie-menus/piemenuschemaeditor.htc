function GetAttStr(node, name, def)
{
  var val = 
    node.getAttribute(name);
  if (val == null) {
    val = def;
  } // if

  return val;
}


function GetAttFloat(node, name, def)
{
  var val = 
    GetAttStr(node, name, "");

  var ival =
    parseFloat(val);

  if (isNaN(ival)) {
    ival = def;
  } // if

  return ival;
}


function GetAttInt(node, name, def)
{
  var val = 
    GetAttStr(node, name, "");

  var ival =
    parseInt(val);

  if (isNaN(ival)) {
    ival = def;
  } // if

  return ival;
}


function parseBool(val, def)
{
  if ((val == true) ||
      (val == false)) {
    return val;
  } // if

  var result = false;

  var ival =
    parseInt(val);

  if (isNaN(ival)) {
    var lowerVal =
      val.toLowerCase();
    if ((lowerVal == "1") ||
        (lowerVal == "true") ||
        (lowerVal == "t") ||
        (lowerVal == "yes") ||
        (lowerVal == "y") ||
        (lowerVal == "on")) {
      result = true;
    } else if ((lowerVal == "0") ||
               (lowerVal == "false") ||
               (lowerVal == "f") ||
               (lowerVal == "no") ||
               (lowerVal == "n") ||
               (lowerVal == "off")) {
      result = false;
    } else {
      result = def ? true : false;
    } // if
  } else {
    if (ival == 0) {
      result = false;
    } else {
      result = true;
    } // if
  } // if

  return result;
}


function GetAttBool(node, name, def)
{
  var val = 
    GetAttStr(node, name, null);

  if (val == null) {
    val = def;
  } else {
    val = parseBool(val, def);
  } // if

  return val;
}


