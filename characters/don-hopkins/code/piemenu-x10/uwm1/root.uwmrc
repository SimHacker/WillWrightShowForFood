dbx:		!"rsh brillig -n xspawn $DISPLAY xterm -e dbx &"
unimacs:	!"rsh brillig -n xspawn $DISPLAY unimacs -Ttty &"
gnumacs:	!"rsh brillig -n xspawn $DISPLAY gnumacs &"
}

