SEN -> (PLS) S
S -> PUTS
S -> PUTBETS
S -> PUTOBS
S -> PUTBOXS
S -> FILLBOXS
S -> WHERES
S -> AGAINS
S -> HOWS
S -> TRACES
S -> PTRACES
S -> LIFTS
S -> GETS
S -> DROPS
S -> CLRTOPS
S -> MAKES
S -> DOLLYS
S -> HELPS
S -> CLEARS
S -> RESETS
S -> QUITS
S -> STACKS

PLS -> (WOULDYOU) PLSWORD
WOULDYOU -> WWORD YOUWORD
WWORD -> [ WOULD ]
YOUWORD -> [ YOU ]
PLSWORD -> [ PLEASE ]

* PUT --- ON ---
PUTS -> VPUT BLOCK ONPREP PP
PUTS -> MPUT BLOCK MTOWORD PP
VPUT -> [ PUT STACK PLACE ]
MPUT -> [ MOVE ]
PP -> BLOCK
PP -> TOPWORD OFWORD BLOCK
ONPREP -> [ ON ]
MTOWORD -> [ ONTO TO ON ]
TOPWORD -> [ TOP ]
OFWORD -> [ OF ]
BLOCK -> ABLOCK
ABLOCK -> (ART) (SIZEWORD) (COLORWORD) OBJWORD
ABLOCK -> [ IT ]
ABLOCK -> BOX
ART -> [ A AN THE ]


SIZEWORD -> [ TINY LITTLE LITTLER LITTLEST SMALL SMALLER SMALLEST 
              HUGE BIG BIGGER BIGGEST LARGE LARGER LARGEST ]

COLORWORD -> [ RED GREEN YELLOW ORANGE ]
OBJWORD -> [ CUBE BLOCK PYRAMID SQUARE TRIANGLE ONE ]

* LIFT
LIFTS -> LS
LS -> VLIFT BLOCK
LS -> PICKWORD BLOCK UPWORD
VLIFT -> [ LIFT GRASP ]
VLIFT -> PICKWORD UPWORD
PICKWORD -> [ PICK ]
UPWORD -> [ UP ]

* DROP
DROPS -> DS
DS -> DROPWORD BLOCK
DS -> VPUT BLOCK DOWNWORD
DS -> VPUT DOWNWORD BLOCK
DS -> VPUT BLOCK ONPREP FLOOR
FLOOR -> (ART) FLOORWORD
FLOORWORD -> [ TABLE TABLETOP FLOOR GROUND ]
DOWNWORD -> [ DOWN ]
DROPWORD -> [ DROP ]

* FILL BOX
FILLBOXS -> FILLWORD BOX
FILLWORD -> [ FILL EMPTY ]
BOX -> (ART) BOXWORD
BOXWORD -> [ BOX ]

* WHERE?
WHERES -> WHRWORD ISWORD BLOCK
WHRWORD -> [ WHERE ]
ISWORD -> [ IS ]

* AGAIN
AGAINS -> [ AGAIN ]

* HOW?
HOWS -> [ HOW ]

* TRACE
TRACES -> TRCWORD ONOFF
TRCWORD -> [ TRACE ]
ONOFF -> [ ON OFF ]

* PTRACE
PTRACES -> PTWORD ONOFF
PTWORD -> [ PTRACE ]

* PUT BETWEEN
PUTBETS -> VPUT BLOCK BETWORD BLOCK ANDWORD BLOCK
BETWORD -> [ BETWEEN ]
ANDWORD -> [ AND ]

* OTHER BETWEENNESS
PUTOBS -> VPUT BLOCK BETREL BLOCK
BETREL -> NEXTTO
BETREL -> BESIDE
BETREL -> NEAR
BETREL -> FRONTOF
BETREL -> BACKOF
BETREL -> BEHIND
BETREL -> RIGHTOF
BETREL -> LEFTOF
NEXTTO -> NEXTWORD TOWORD
NEXTWORD -> [ NEXT ]
TOWORD -> [ TO ]
BESIDE -> [ BESIDE ]
BEHIND -> [ BEHIND ]
NEAR -> [ NEAR ]
INWORD -> [ IN ]
FRONTWORD -> [ FRONT ]
BACKWORD -> [ BACK ]
LEFTWORD -> [ LEFT ]
RIGHTWORD -> [ RIGHT ]
FRONTOF -> (INWORD) FRONTWORD OFWORD
BACKOF -> (INWORD) BACKWORD OFWORD
TOTHE -> TOWORD (ART)
LEFTOF -> (TOTHE) LEFTWORD OFWORD
RIGHTOF -> (TOTHE) RIGHTWORD OFWORD

* PUT IN BOX
VPUTBOX -> [ PUT ]
BOXINWORD -> [ IN INTO ]
PUTBOXS -> VPUTBOX BLOCK BOXINWORD BOX

* CLRTOP
CLRTOPS -> CLRWORD (TOPOF) BLOCK
TOPOF -> (ART) TOPWORD OFWORD
CLRWORD -> [ CLEAR ]

* MAKE/BUILD A ---
MAKES -> VMAKE (ART) THING
VMAKE -> [ BUILD MAKE CREATE ]
THING -> [ SLINKY TOWER TOWN ]

* DOLLY ---
DOLLYS -> DOLLYWORD DIR
DOLLYWORD -> [ DOLLY ]
DIR -> [ LEFT RIGHT UP DOWN CENTER ]

* HELP
HELPS -> [ HELP ]

* CLEAR
CLEARS -> CLRWORD (SCR)
SCR -> (ART) SCRWORD
SCRWORD -> [ SCREEN ]

* RESET
RESETS -> [ RESET ]

* QUIT
QUITS -> [ QUIT BYE GOODBYE EXIT END ]
end
