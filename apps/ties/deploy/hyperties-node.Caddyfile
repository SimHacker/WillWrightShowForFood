# HyperTIES — files off the symlink, process only for proxy / views / auth.
#
# If the process dies, the encyclopedia still reads. Only /proxy, /view and
# /api 502. That is the point of not making the corpus dynamic.
#
# root and reverse_proxy names are the global /data namespace and the compose
# service name. Same strings on the host.

hyperties.org {
	encode zstd gzip

	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	handle /proxy/* {
		reverse_proxy hyperties:3000
	}

	handle /view/* {
		reverse_proxy hyperties:3000
	}

	handle /api/* {
		reverse_proxy hyperties:3000
	}

	handle {
		root * /data/releases/hyperties/current
		@documents not path /_app/immutable/*
		header @documents Cache-Control "public, max-age=300"
		file_server
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

hyperties.net, hyperties.link, www.hyperties.org, www.hyperties.net, www.hyperties.link {
	redir https://hyperties.org{uri} permanent
}
