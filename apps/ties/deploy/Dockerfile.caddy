# syntax=docker/dockerfile:1

# Caddy, with HyperTIES baked in.
#
# Build context: apps/ties/ (parent of deploy/).
#
# The reader prerenders to plain files, so the deployed artifact is a web server with a
# directory inside it and no application process at all. That makes a deploy atomic -- a
# new image either exists or it doesn't, and there is no window where half the articles
# are the old ones -- and it makes the running container immutable, which is the whole
# reason to prefer this over mounting the build output from the host.
#
# The corpus is converted ahead of time and committed, so this stage needs no Python:
# scripts/convert-all.py runs on a workstation, its markdown output is in git, and
# import.meta.glob picks it up at build time. Deploys therefore cannot be broken by a
# converter change that was never reviewed.

FROM node:22-bookworm-slim AS build
WORKDIR /app

# Dependencies first, so editing an article does not re-resolve the tree. npm ci installs
# exactly package-lock.json and fails loudly if the two have drifted apart.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build


FROM caddy:2-alpine

# The site. 138 prerendered pages plus about 2 MB of converted assets.
COPY --from=build /app/build /srv/hyperties

# The site block for the three names. The main Caddyfile imports this by filename, and
# both live in /etc/caddy, so the import resolves relative to it.
COPY deploy/hyperties.Caddyfile /etc/caddy/hyperties.Caddyfile
