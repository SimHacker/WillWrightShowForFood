		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/bcryptjs": "^3.0.0",
		"@types/geojson": "^7946.0.16",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
