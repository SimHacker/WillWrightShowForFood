# Ebike Safari production — copy to deploy/.env on the server
# cp .env.example .env && chmod 600 .env

# Public site
DOMAIN=ebike-safari.com
ACME_EMAIL=you@example.com

# Postgres (PostGIS container)
POSTGRES_DB=ebike_safari
POSTGRES_USER=ebike
POSTGRES_PASSWORD=change-me-use-openssl-rand-base64-32

# SvelteKit (adapter-node) — ORIGIN must match public HTTPS URL
ORIGIN=https://ebike-safari.com

# Mapbox — server-only name on purpose (see README.md section 4).
# NOT PUBLIC_MAPBOX_TOKEN: the viewer prerenders with ssr=false, so a PUBLIC_ var is
# compiled into the static bundle and baked into the image. Keep it private and serve it
# from a +server.ts at runtime, so rotating the token is a restart, not a rebuild.
# Value lives in 1Password: op://Personal/Mapbox/token (Ground Up Software account).
MAPBOX_TOKEN=

# Optional: import script / future API (not used by viewer v0 yet)
# DATABASE_URL=postgresql://ebike:change-me@db:5432/ebike_safari
