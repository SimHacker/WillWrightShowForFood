# LOCAL DEVELOPMENT ONLY — copy to deploy/.env for docker-compose.dev.yml on a laptop.
#
# Production does NOT use this file. Secrets on the server are one file per secret under
# /data/secrets/, reaching only the services that name them, and each app has its own postgres
# role rather than sharing the superuser. See server/SECRETS.md for the layout, the threat model,
# and the commands to create them.
#
# A combined file like this one is convenient on a laptop, where every value is a throwaway, and
# wrong on a server, where it means every secret reaches every service.

DOMAIN=localhost
ORIGIN=http://localhost:3000

# Throwaway local postgres. On the server these live in
#   /data/secrets/postgres/superuser.env      (db only)
#   /data/secrets/postgres/roles/<app>.env    (that app only)
POSTGRES_DB=ebike_safari
POSTGRES_USER=ebike
POSTGRES_PASSWORD=local-dev-only

# Mapbox — server-only name on purpose (see README.md section 4).
# NOT PUBLIC_MAPBOX_TOKEN: the viewer prerenders with ssr=false, so a PUBLIC_ var is
# compiled into the static bundle and baked into the image. Keep it private and serve it
# from a +server.ts at runtime, so rotating the token is a restart, not a rebuild.
# Value lives in 1Password: op://Personal/Mapbox/token (Ground Up Software account).
# On the server: /data/secrets/mapbox/token.env
MAPBOX_TOKEN=

# ACME is not used locally; the dev stack serves plain HTTP.
# On the server: /data/secrets/acme/email.env
