# syntax=docker/dockerfile:1

# Build context: apps/ebike-safari/ (parent of deploy/ and viewer/)

FROM node:22-bookworm-slim AS build

RUN corepack enable

WORKDIR /app/viewer

COPY viewer/package.json viewer/.npmrc ./
RUN pnpm install

COPY viewer/ .

COPY demo/web/data /app/demo/web/data

RUN rm -rf node_modules && pnpm install

RUN bash scripts/sync-data.sh

ENV SVELTE_ADAPTER=node
RUN pnpm build

FROM node:22-bookworm-slim AS run

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --from=build /app/viewer/build ./build
COPY --from=build /app/viewer/package.json ./
COPY --from=build /app/viewer/node_modules ./node_modules
# Own HTTP server so Socket.IO can share the port with SvelteKit.
COPY --from=build /app/viewer/server.js /app/viewer/socket-server.js ./
COPY deploy/docker-entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
	CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "server.js"]
