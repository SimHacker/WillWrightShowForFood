# HyperTIES: hyperties.org, .net, .link, served as files from a bind-mounted release.
# Name-based virtual hosting, so one Caddy and one IP carry both sites and each name gets
# its own certificate. The imported file is owned by apps/ties and mounted into /etc/caddy
# by compose -- add a site here by importing it, not by editing this block.
import hyperties.Caddyfile
